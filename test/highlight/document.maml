  #       ^ punctuation.delimiter
  #         ^ string
  #                ^ constant.builtin
  #                      ^ boolean
  #                           ^ punctuation.bracket
  esc: "a\nb"
  # <- property
  #     ^ string
  #      ^ string.escape
  raw: """x \n y"""
  #    ^ string
  #         ^ string
}
